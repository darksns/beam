#!/usr/bin/env node
/* beam — CLI: talks to the local hub, which relays to the Chrome extension.
 * Starts the hub by itself when it is not running. Compact text output. */
'use strict';
const path = require('path');
const os = require('os');
const fs = require('fs');
const { spawn } = require('child_process');
const pkg = require(path.join(__dirname, '..', 'package.json'));
const { sessionOf } = require('./session-name');
const VERSION = pkg.version;

const PORT = Number(process.env.BEAM_PORT || 8777);
const BASE = `http://127.0.0.1:${PORT}`;
const SERVER = path.join(__dirname, '..', 'server', 'server.js');
const HOME = process.env.BEAM_HOME || path.join(os.homedir(), '.beam');

/* the hub writes this on first run; it is what proves we are not a web page */
function token() {
  try { return fs.readFileSync(path.join(HOME, 'token'), 'utf8').trim(); }
  catch (e) { return ''; }
}

/* ---------------------------------------------------------------- args */

/* value-less flags: otherwise they would swallow the argument that follows
   (e.g. `beam set --dry '{...}'`) */
const BOOL = new Set(['json', 'dry', 'hidden', 'raw', 'background', 'stop', 'all', 'force', 'focus', 'new', 'failed', 'clear',
  'boxes', 'marks', 'png', 'hires']);

const argv = process.argv.slice(2);
const op = argv.shift();
const positional = [];
const opts = {};
for (let i = 0; i < argv.length; i++) {
  const a = argv[i];
  if (a.startsWith('--')) {
    const key = a.slice(2);
    const next = argv[i + 1];
    if (BOOL.has(key) || next === undefined || next.startsWith('--')) opts[key] = true;
    else { opts[key] = /^\d+$/.test(next) ? Number(next) : next; i++; }
  } else positional.push(a);
}

const HELP = `beam — drive Chrome as text

  read
    beam snap    [--sel CSS] [--max N] [--hidden] [--boxes]
                                                    interactive elements, with @n refs;
                                                    --boxes adds [x,y wxh] and canvas/img/svg
    beam outline [--sel CSS] [--depth N]            structure tree
    beam fields  [--sel CSS] [--hidden]             every form field (JSON)
    beam text    [--sel CSS] [--max N] [--from N]   readable text
    beam html    [--sel CSS] [--max N]              raw HTML
    beam info | tabs | frames | sessions
    beam network [filter] [--type xhr,doc,js,css,img] [--method M] [--failed] [--last N] [--clear]
                                                    requests of the bound tab (no bodies);
                                                    turn it on in the Beam panel first

  act
    beam open <url> [--new] [--focus]   its own window, unfocused; reuses that session's tab
    beam focus                          bring the Beam window forward
    beam nav <url> | reload | back | forward | close | use <tab> [--focus]
    beam click <target> [--at x,y]      --at: a point inside it, from its top-left corner
    beam hover <target>                 mouseover/mousemove at the element's center
    beam fill <target> <value>
    beam select <target> <value>
    beam check <target> [on|off]
    beam press <Key>
    beam upload <target> <url|file>     a file into an input[type=file]
    beam drop <target> <url|file>... [--text T] [--at x,y]
                                        drop files (or text) onto a dropzone
    beam drag <target> <to> [--at x,y] [--from x,y] [--mode auto|html5|mouse] [--steps N]
                                        drag an element onto another (sort, move)
    beam set '<json>' | @file.json      fill many fields at once (--dry to preview)
    beam do  '<json>' | @file.json      a sequence of steps in one round trip
    beam wait [--sel CSS] [--text T] [--timeout ms]
    beam scroll [--sel CSS] [--by N]    scroll the page, or one element into view
    beam shot [<target>] [--marks] [--hires] [--out file.jpg]
                                        screenshot to a file (only when truly needed):
                                        <target> crops to one element; --marks draws
                                        the @n refs on it and prints their legend;
                                        both come at CSS size unless --hires

  target: @12 (ref from snap) · @3:12 (ref inside frame 3) · css=.klass · text=Update
          label=Title · name=post_title · title=Heading Settings · xy=120,40 (viewport point)
  global: --tab <id>  --session <nome>  --frame <id|all>  --json  --vlen <n>  --timeout <ms>
          BEAM_SESSION=<nome>   named window; unset follows the Claude/Cursor chat, else "default"
  setup
    beam extension                      copy the extension to ~/.beam/extension, to load unpacked
    beam server [--stop]                hub status, or stop it (it restarts on the next command)
    beam --version | -v                 print the CLI version
`;

if (!op || op === 'help' || op === '--help' || op === '-h') { process.stdout.write(HELP); process.exit(0); }
if (op === '--version' || op === '-v') { process.stdout.write(VERSION + '\n'); process.exit(0); }

/* -------------------------------------------------------------- server */

async function health() {
  try {
    const r = await fetch(BASE + '/health', {
      headers: { 'x-beam-token': token() },
      signal: AbortSignal.timeout(1500)
    });
    if (r.status === 401) return { unauthorized: true };
    return await r.json();
  } catch (e) { return null; }
}

async function ensureServer() {
  const h = await health();
  if (h && h.unauthorized) {
    console.error('the hub on port ' + PORT + ' does not accept this token.\n' +
      'It is probably an older instance: stop it (`beam server --stop`) and retry.');
    process.exit(1);
  }
  if (h) {
    /* a plugin or npm update installs the new code elsewhere, and the hub
       started from the old copy keeps running until someone stops it */
    if (h.version !== VERSION) {
      console.error(`note: the running hub is ${h.version ? 'version ' + h.version : 'from an older Beam'}, ` +
        `this CLI is ${VERSION}. \`beam server --stop\` restarts it on the next command.`);
    }
    return true;
  }
  const child = spawn(process.execPath, [SERVER], { detached: true, stdio: 'ignore' });
  child.unref();
  for (let i = 0; i < 30; i++) {
    await new Promise((r) => setTimeout(r, 100));
    const s = await health();
    if (s && !s.unauthorized) return true;
  }
  return false;
}

/* ------------------------------------------------------------ commands */

/* A local file, sent as bytes: the extension cannot read the disk. The hub
   takes 20 MB of JSON, and base64 grows by a third. */
const MIME = { '.jpg': 'image/jpeg', '.jpeg': 'image/jpeg', '.png': 'image/png', '.gif': 'image/gif',
  '.webp': 'image/webp', '.avif': 'image/avif', '.svg': 'image/svg+xml', '.pdf': 'application/pdf',
  '.txt': 'text/plain', '.csv': 'text/csv', '.json': 'application/json', '.zip': 'application/zip',
  '.mp4': 'video/mp4', '.mp3': 'audio/mpeg', '.doc': 'application/msword',
  '.docx': 'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
  '.xlsx': 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' };

function localFile(p) {
  const st = fs.statSync(p);
  if (!st.isFile()) throw new Error('not a file: ' + p);
  if (st.size > 14e6) throw new Error('file too large to send through the hub (14 MB max): ' + p);
  return {
    b64: fs.readFileSync(p).toString('base64'),
    name: path.basename(p),
    mime: MIME[path.extname(p).toLowerCase()] || 'application/octet-stream'
  };
}

const isUrl = (v) => /^(https?|data):/i.test(String(v || ''));

function readArg(v) {
  if (typeof v === 'string' && v.startsWith('@') && v.length > 1 && !/^@\d+$/.test(v)) {
    return fs.readFileSync(v.slice(1), 'utf8');
  }
  return v;
}

/* "@3:14" means ref 14 inside frame 3: the frame is pulled out here, so a
   target copied from a multi-frame snap works with no extra flags */
function splitFrame(cmd, key) {
  const m = /^@(\d+):(\d+)$/.exec(String(cmd[key] || ''));
  if (!m) return;
  if (cmd.frame == null) cmd.frame = Number(m[1]);
  cmd[key] = '@' + m[2];
}

function build() {
  const cmd = { op };
  for (const k of Object.keys(opts)) cmd[k] = opts[k];

  switch (op) {
    case 'open': case 'nav': cmd.url = positional[0]; break;
    case 'use': cmd.tab = positional[0]; break;
    case 'click': case 'hover': cmd.target = positional[0]; break;
    case 'drag': cmd.target = positional[0]; cmd.to = positional[1]; break;
    case 'drop':
      cmd.target = positional[0];
      cmd.urls = positional.slice(1).filter(isUrl);
      cmd.files = positional.slice(1).filter((p) => !isUrl(p)).map(localFile);
      break;
    case 'shot': if (positional[0]) cmd.target = positional[0]; break;
    case 'fill': case 'select':
      cmd.target = positional[0];
      cmd.value = positional.slice(1).join(' ');
      break;
    case 'check':
      cmd.target = positional[0];
      cmd.value = positional[1] === undefined ? true : !/^(off|false|0|no)$/i.test(positional[1]);
      break;
    case 'press': cmd.key = positional[0]; break;
    case 'upload':
      cmd.target = positional[0];
      if (isUrl(positional[1])) cmd.url = positional[1];
      else Object.assign(cmd, localFile(positional[1]), opts.name ? { name: opts.name } : {});
      break;
    case 'set': cmd.map = JSON.parse(readArg(positional[0])); break;
    case 'do': {
      const parsed = JSON.parse(readArg(positional[0]));
      cmd.steps = Array.isArray(parsed) ? parsed : parsed.steps;
      break;
    }
    case 'network':
      if (positional[0] && !opts.filter) cmd.filter = positional[0];
      break;
    case 'text': case 'html': case 'snap': case 'outline': case 'fields':
      if (positional[0] && !opts.sel) cmd.sel = positional[0];
      break;
  }
  if (cmd.newTab === 'false') cmd.newTab = false;
  if (cmd.target) splitFrame(cmd, 'target');
  if (cmd.to) splitFrame(cmd, 'to');
  /* `text --from N` is an offset; on a drag, --from is a point */
  if (/^(click|drag|drop)$/.test(op) && (typeof cmd.at === 'number' || typeof cmd.from === 'number')) {
    throw new Error('--at and --from want x,y');
  }
  if (cmd.frame === 'true') cmd.frame = 'all';
  cmd.session = sessionOf(opts.session, process.env);
  return cmd;
}

/* -------------------------------------------------------------- render */

function render(op, r) {
  if (opts.json) return JSON.stringify(r, null, 2);
  if (r == null) return 'ok';

  if (op === 'hover') {
    const head = `hovered ${r.hovered} · ${r.x},${r.y}` +
      (r.layout === false ? '\nno layout on this tab — `beam use` it and hover again' : '');
    return [head, `${r.count} revealed`, '', r.revealed || ''].join('\n').trimEnd();
  }
  if (op === 'snap') {
    return [`${r.title}`, `${r.url}`, `${r.elements} elements${r.truncated ? ' · ' + r.truncated : ''}`, '', r.outline].join('\n');
  }
  if (op === 'outline') return [`${r.title}`, `${r.url}`, '', r.structure].join('\n');
  if (op === 'text') return [`${r.title} · ${r.chars} characters`, '', r.text].join('\n');
  if (op === 'html') return r.html;
  if (op === 'tabs') {
    return r.map((t) => `${t.current ? '*' : ' '} [${t.tab}]${t.beam ? ' beam:' + t.beam : ''} ${(t.title || '').slice(0, 60)}\n      ${t.url}`).join('\n');
  }
  if (op === 'sessions') {
    if (!r.length) return 'no sessions';
    return r.map((s) => `${s.current ? '*' : ' '} ${s.session}  [${s.tab == null ? '—' : s.tab}]  ${s.title || ''}\n      ${s.url || ''}`).join('\n');
  }
  if (op === 'fields') {
    const cut = (v) => {
      const s = String(v == null ? '' : v);
      return JSON.stringify(s.length > 200 ? s.slice(0, 200) + '…' : s) +
        (s.length > 200 ? `  (${s.length} characters: --json for the whole value)` : '');
    };
    return [`${r.count} fields · ${r.url}`, ''].concat(r.fields.map((f) =>
      `${f.ref} ${f.type}${f.required ? '*' : ''}${f.hidden ? ' (hidden)' : ''}  "${f.label}"` +
      `\n    name=${f.name || '—'}  sel=${f.selector}` +
      `\n    = ${f.secret ? (f.length ? `<hidden, ${f.length} chars>` : '""') : cut(f.value)}`)).join('\n');
  }
  if (op === 'frames') {
    return r.map((f) => `[${f.frame}]${f.injectable ? '' : ' (not injectable)'} ${f.title || ''}\n     ${f.url}`).join('\n');
  }
  if (op === 'network') {
    const head = `${r.count} of ${r.total} requests · tab ${r.tab}${r.cleared ? ' · cleared' : ''}`;
    return [head, ''].concat(r.requests.map((q) => {
      const st = q.error ? '✗' : q.status == null ? '…' : String(q.status);
      const type = q.type === 'xmlhttprequest' ? 'xhr' : q.type === 'main_frame' ? 'doc' : q.type;
      const ms = q.ms == null ? '' : q.ms + 'ms';
      return `${st.padEnd(3)} ${q.method.padEnd(6)} ${type.padEnd(10)} ${ms.padStart(7)}${q.cache ? ' cache' : ''}  ${q.url}` +
        (q.error ? `\n    ${q.error}` : '');
    })).join('\n').trimEnd();
  }
  if (op === 'drag') {
    return `dragged ${r.dragged} → ${r.to} · ${r.mode}` +
      (r.accepted === false ? '\nthe target did not accept the drop (it never cancelled dragover)' : '') +
      (r.note ? '\n' + r.note : '');
  }
  if (op === 'drop') {
    return `dropped ${r.dropped} on ${r.on}` +
      (r.accepted ? '' : '\nthe target did not accept it (no handler cancelled dragover or drop): try the zone itself, or the page body');
  }
  if (op === 'click' && r.x != null) return `clicked ${r.clicked} · ${r.x},${r.y}` +
    (r.layout === false ? '\nno layout on this tab — `beam open` it in Beam\'s window' : '');
  if (op === 'upload') return `${r.uploaded} · ${Math.round(r.bytes / 1024)} KB · ${r.type}`;
  if (op === 'do') {
    return r.steps.map((s) => `${s.error ? '✗' : '✓'} ${s.step} ${s.op}  ${s.error || JSON.stringify(s.result)}`).join('\n');
  }
  if (op === 'set' && r.dry) {
    const ch = r.changes.filter((c) => c.changed);
    return [`preview: ${ch.length} fields would change out of ${r.changes.length} resolved`, '']
      .concat(ch.map((c) => `~ ${c.label}\n    - ${JSON.stringify(c.from)}\n    + ${JSON.stringify(c.to)}`))
      .concat(r.errors.length ? ['', '✗ ' + r.errors.join('\n✗ ')] : []).join('\n');
  }
  if (op === 'set') {
    return `${r.filled} filled` + (r.errors.length ? '\n✗ ' + r.errors.join('\n✗ ') : '');
  }
  return JSON.stringify(r, null, 2);
}

/* ----------------------------------------------------------------- run */

/* The extension, copied where an update does not move it: a plugin or npm
   update installs into a new folder, and Chrome drops an unpacked extension
   whose folder has gone. */
function copyExtension() {
  const src = path.join(__dirname, '..', 'extension');
  const dest = path.join(HOME, 'extension');
  if (fs.existsSync(path.join(dest, 'manifest.json'))) fs.rmSync(dest, { recursive: true, force: true });
  fs.cpSync(src, dest, { recursive: true });
  console.log(`extension ${VERSION} copied to ${dest}

Once, in Chrome:
  1. open chrome://extensions
  2. turn on Developer mode
  3. Load unpacked → ${dest}

After an update: beam extension && beam reloadext`);
}

(async () => {
  if (op === 'extension') { copyExtension(); return; }

  if (op === 'server') {
    const h = await health();
    if (opts.stop) {
      if (h && h.pid) process.kill(h.pid);
      console.log(h && h.pid ? 'server stopped' : 'not running');
      return;
    }
    if (h && !h.unauthorized) { console.log(JSON.stringify(h, null, 2)); return; }
    await ensureServer();
    console.log(JSON.stringify(await health(), null, 2));
    return;
  }

  if (!(await ensureServer())) {
    console.error('cannot start the local hub (' + SERVER + ')');
    process.exit(1);
  }

  let cmd;
  try { cmd = build(); }
  catch (e) { console.error('invalid arguments: ' + e.message); process.exit(1); }

  const res = await fetch(BASE + '/cmd', {
    method: 'POST',
    headers: { 'content-type': 'application/json', 'x-beam-token': token() },
    body: JSON.stringify(cmd)
  }).then((r) => r.json());

  if (!res.ok) { console.error('✗ ' + res.error); process.exit(2); }

  if (op === 'shot' && res.result && res.result.dataUrl) {
    const out = opts.out || path.join(os.tmpdir(), `beam-shot-${Date.now()}.jpg`);
    const b64 = res.result.dataUrl.replace(/^data:[^,]+,/, '');
    fs.writeFileSync(out, Buffer.from(b64, 'base64'));
    if (opts.json) {
      console.log(JSON.stringify(Object.assign({}, res.result, { dataUrl: undefined, file: out }), null, 2));
      return;
    }
    console.log(out);
    /* the legend of the labels drawn on the picture */
    if (res.result.outline != null) {
      console.log(`${res.result.marked} marked on screen · ${res.result.elements} elements\n\n${res.result.outline}`);
    }
    return;
  }

  console.log(render(op, res.result));
})().catch((e) => { console.error(String(e && e.message || e)); process.exit(1); });
